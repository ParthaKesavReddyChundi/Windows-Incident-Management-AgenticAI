# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ─── Frontend ─────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/ws

# ─── Telemetry Collection ─────────────────────────────────────────────────────
TELEMETRY_INTERVAL_SECONDS=5
TELEMETRY_QUEUE_MAX_SIZE=200

# ─── Anomaly Detection ────────────────────────────────────────────────────────
ANOMALY_THRESHOLD=0.5
MODEL_PATH=models/autoencoder.pt

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_MODELS_DIR=  # Uncomment to override default model storage path

# ─── RAG ──────────────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=vector_store
RAG_COLLECTION_NAME=windows_knowledge
RAG_TOP_K=5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./database/incidents.db

# ─── Security ─────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
